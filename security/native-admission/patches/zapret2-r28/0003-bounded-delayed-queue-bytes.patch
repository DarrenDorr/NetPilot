diff --git a/nfq2/packet_queue.h b/nfq2/packet_queue.h
--- a/nfq2/packet_queue.h
+++ b/nfq2/packet_queue.h
@@ -27,9 +27,12 @@
 {
 	struct rawpacket_tailhead q;
 	unsigned int max_packets;
+	size_t max_bytes;
+	size_t queued_bytes;
 };
 
 void rawpacket_queue_init(struct rawpacket_queue *q, unsigned int max_packets);
+void rawpacket_queue_set_max_bytes(struct rawpacket_queue *q, size_t max_bytes);
 void rawpacket_queue_destroy(struct rawpacket_queue *q);
 bool rawpacket_queue_empty(const struct rawpacket_queue *q);
 unsigned int rawpacket_queue_count(const struct rawpacket_queue *q);
diff --git a/nfq2/packet_queue.c b/nfq2/packet_queue.c
--- a/nfq2/packet_queue.c
+++ b/nfq2/packet_queue.c
@@ -8,6 +8,12 @@
 {
 	TAILQ_INIT(&q->q);
 	q->max_packets = max_packets;
+	q->max_bytes = 0;
+	q->queued_bytes = 0;
+}
+void rawpacket_queue_set_max_bytes(struct rawpacket_queue *q, size_t max_bytes)
+{
+	q->max_bytes = max_bytes;
 }
 void rawpacket_free(struct rawpacket *rp)
 {
@@ -18,13 +24,18 @@
 {
 	struct rawpacket *rp;
 	rp = TAILQ_FIRST(&q->q);
-	if (rp)	TAILQ_REMOVE(&q->q, rp, next);
+	if (rp)
+	{
+		TAILQ_REMOVE(&q->q, rp, next);
+		q->queued_bytes = rp->len > q->queued_bytes ? 0 : q->queued_bytes - rp->len;
+	}
 	return rp;
 }
 void rawpacket_queue_destroy(struct rawpacket_queue *q)
 {
 	struct rawpacket *rp;
 	while((rp = rawpacket_dequeue(q))) rawpacket_free(rp);
+	q->queued_bytes = 0;
 }
 
 struct rawpacket *rawpacket_queue(
@@ -37,6 +48,9 @@
 	bool server_side)
 {
 	if (q->max_packets && rawpacket_queue_count(q)>=q->max_packets) return NULL;
+	if (len > SIZE_MAX - q->queued_bytes) return NULL;
+	size_t new_queued_bytes = q->queued_bytes + len;
+	if (q->max_bytes && new_queued_bytes > q->max_bytes) return NULL;
 
 	struct rawpacket *rp = malloc(sizeof(struct rawpacket));
 	if (!rp) return NULL;
@@ -74,6 +88,7 @@
