 		ConntrackFeedPacket(&ctr->track, (b_rev = false), dis);
@@ -278,14 +278,14 @@
 			goto ok;
 		}
 	}
-	return false;
+	return CTRACK_FEED_NONE;
 ok:
 	ctr->track.pos.ipproto = proto;
 	if (ctrack) *ctrack = &ctr->track;
 	if (bReverse) *bReverse = b_rev;
