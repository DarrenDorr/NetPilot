<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetPilot.App.ViewModels"
        x:Class="NetPilot.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100"
        Height="790"
        MinWidth="820"
        MinHeight="640"
        Background="#090F1D"
        Foreground="#E8EEFA"
        FontFamily="Segoe UI">
  <Grid ColumnDefinitions="Auto,*">
    <!-- Left: navigation and operations; every interactive item is wired. -->
    <Border Grid.Column="0"
            Width="{Binding SidebarWidth}"
            Padding="16,22"
            Background="#101A2E"
            BorderBrush="#27354C"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="20">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="12" Background="#2251AA">
              <TextBlock Text="N" FontSize="26" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,2,0,0"
                        IsVisible="{Binding IsMenuExpanded}" Spacing="0">
              <TextBlock Text="NetPilot" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Text="Панель управления" FontSize="11"
                         Foreground="#A3B3CC" />
            </StackPanel>
          </Grid>

          <ToggleButton Content="☰"
                        ToolTip.Tip="Показать или скрыть боковую панель"
                        IsChecked="{Binding IsMenuExpanded}"
                        Width="44" Height="38"
                        HorizontalAlignment="Left"
                        Background="#1D2C47"
                        BorderBrush="#344A6F"
                        FontSize="20" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsMenuExpanded}"
                    Margin="0,28,0,0"
                    Spacing="12">
          <TextBlock Text="ДЕЙСТВИЯ" FontSize="11" FontWeight="SemiBold"
                     Foreground="#8498BA" Margin="4,0,0,4" />

          <Button Content="Проверить через ByeDPI"
                  Command="{Binding CheckCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="15,12"
                  Background="#1B2B46"
                  BorderBrush="#314665"
                  CornerRadius="10" />

          <Button Content="Прямое подключение"
                  Command="{Binding CheckDirectCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="15,12"
                  Background="#1B2B46"
                  BorderBrush="#314665"
                  CornerRadius="10" />

          <TextBlock Text="Цель подбора" Foreground="#A3B3CC" FontSize="12" />
          <ComboBox ItemsSource="{Binding StrategyTargets}"
                    SelectedItem="{Binding SelectedStrategyTarget, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    MinHeight="38">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StrategyTargetOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Button Content="Подобрать стратегию"
                  Command="{Binding FindStrategyCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="15,12"
                  Background="#1B2B46"
                  BorderBrush="#314665"
                  CornerRadius="10" />

          <Border Height="1" Background="#2C3B55" Margin="0,16,0,10" />

          <TextBlock Text="НАСТРОЙКИ" FontSize="11" FontWeight="SemiBold"
                     Foreground="#8498BA" Margin="4,0,0,4" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding IsAdvancedMode}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Показать или скрыть техническую информацию" />
            <TextBlock Text="Режим эксперта"
                       VerticalAlignment="Center" FontSize="13"
                       Foreground="#CFD9EA" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    IsVisible="{Binding IsMenuExpanded}"
                    Spacing="4">
          <TextBlock Text="ByeDPI · пользовательский режим" FontSize="11"
                     TextWrapping="Wrap" Foreground="#95A8C2" />
          <TextBlock Text="Без службы и WinDivert" FontSize="11"
                     Foreground="#6D829F" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The primary view stays usable without opening the expert panel. -->
    <ScrollViewer Grid.Column="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,20,24,24"
                  MaxWidth="1180"
                  HorizontalAlignment="Stretch"
                  Spacing="15">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="NetPilot" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="Управление соединением и проверенными сервисами"
                       FontSize="13" Foreground="#98ABC7" />
          </StackPanel>
          <Border Grid.Column="1" VerticalAlignment="Center"
                  Padding="12,7" CornerRadius="13"
                  Background="#182A44"
                  BorderBrush="#304E75" BorderThickness="1">
            <TextBlock Text="USER MODE" FontSize="11" FontWeight="SemiBold"
                       Foreground="#9CCBFF" />
          </Border>
        </Grid>

        <Border Padding="18" CornerRadius="22"
                Background="#15243E"
                BorderBrush="#314765"
                BorderThickness="1">
          <StackPanel HorizontalAlignment="Stretch" Spacing="10">
            <TextBlock Text="Подключение"
                       FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="#DCE9FA" />
            <TextBlock Text="Запуск и остановка без повышения прав"
                       FontSize="12"
                       HorizontalAlignment="Center" Foreground="#A5B6CE" />
            <Button Command="{Binding ToggleEngineCommand}"
                    Width="168" Height="168"
                    HorizontalAlignment="Center"
                    Background="#2367C8"
                    BorderBrush="{Binding EngineStatusBrush}"
                    BorderThickness="5"
                    CornerRadius="84"
                    Padding="20"
                    ToolTip.Tip="Запустить или остановить локальный движок ByeDPI">
              <TextBlock Text="{Binding EngineActionText}"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         FontSize="18"
                         FontWeight="Bold"
                         Foreground="#FFFFFF" />
            </Button>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" Spacing="8">
              <TextBlock Text="●"
                         FontSize="17"
                         VerticalAlignment="Center"
                         Foreground="{Binding EngineStatusBrush}" />
              <TextBlock Text="{Binding EngineStatus}"
                         FontSize="14"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         Foreground="#CFDDF1" />
            </StackPanel>
            <Border Background="#1D314F" CornerRadius="12"
                    Padding="14,11" Margin="0,4,0,0">
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding OverallStatus}"
                           FontSize="19" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding OverallDetails}"
                           FontSize="13" Foreground="#A5BAD4"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Сервисы" FontSize="19" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="HTTPS-адреса, не состояние приложений"
                     VerticalAlignment="Center" FontSize="11"
                     Foreground="#879BB8" />
        </Grid>

        <TextBlock Text="{Binding HealthRouteDescription}"
                   Foreground="#98ABC7" FontSize="12"
                   TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Resources}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ResourceStatusViewModel">
              <Border Width="255" MinHeight="80" Padding="13"
                      Margin="0,0,12,12"
                      CornerRadius="14"
                      Background="#132137"
                      BorderThickness="1"
                      BorderBrush="#2B3E59">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Background="#20334F"
                          CornerRadius="11" Width="40" Height="40"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusGlyph}"
                               Foreground="{Binding StatusBrush}"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1"
                              Margin="14,0,14,0"
                              VerticalAlignment="Center"
                              Spacing="4">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DetailsText}"
                               FontSize="11"
                               Foreground="#93A6C0"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="2"
                             VerticalAlignment="Center"
                             Text="{Binding StatusText}"
                             Foreground="{Binding StatusBrush}"
                             FontSize="12"
                             FontWeight="SemiBold" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- One actual local event; do not simulate a live news feed. -->
        <Border CornerRadius="15" Padding="18"
                Background="#14223A" BorderBrush="#2D405C"
                BorderThickness="1">
          <StackPanel Spacing="7">
            <TextBlock Text="Последние события"
                       FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LastAction}"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="#AFBED3" />
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsAdvancedMode}"
                CornerRadius="15" Padding="20"
                Background="#111E32"
                BorderBrush="#354865"
                BorderThickness="1">
          <StackPanel Spacing="12">
            <TextBlock Text="Техническая информация"
                       FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="146,*" RowDefinitions="Auto,Auto">
              <TextBlock Text="Сетевой движок" Foreground="#A2B3CB" />
              <TextBlock Grid.Column="1"
                         Text="{Binding EngineStatus}"
                         TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="Последнее действие"
                         Margin="0,7,0,0" Foreground="#A2B3CB" />
              <TextBlock Grid.Row="1" Grid.Column="1"
                         Text="{Binding LastAction}"
                         Margin="0,7,0,0" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="146,*">
              <TextBlock Text="SOCKS5 (вручную)" Foreground="#A2B3CB" />
              <TextBlock Grid.Column="1" Text="{Binding LocalSocks5Address}"
                         TextWrapping="Wrap" Foreground="#CFDDF1" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Button Content="Скопировать SOCKS5"
                      Click="OnCopySocks5AddressClicked"
                      IsEnabled="{Binding IsEngineRunning}"
                      Padding="12,7"
                      Background="#244875"
                      BorderBrush="#416996"
                      CornerRadius="8"
                      ToolTip.Tip="Копирует только локальный адрес работающего ByeDPI; настройки Windows не меняются." />
              <TextBlock x:Name="CopySocks5Feedback"
                         VerticalAlignment="Center"
                         Foreground="#9DB6D4"
                         FontSize="11"
                         TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="Для приложений с поддержкой SOCKS5: настраивайте прокси только в самом приложении. NetPilot не перенаправляет весь трафик Windows."
                       FontSize="11" Foreground="#8497B4" TextWrapping="Wrap" />
            <TextBlock Text="Контрольный SOCKS5-профиль" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Только для диагностики HTTPS. Смена профиля перезапускает принадлежащий NetPilot движок и изменяет локальный порт. После теста верните рекомендуемую стратегию."
                       FontSize="11" Foreground="#A2B3CB" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Без модификаций TLS"
                      Command="{Binding ActivateDiagnosticCommand}"
                      Padding="12,7" Background="#244875" BorderBrush="#416996"
                      CornerRadius="8" />
              <Button Content="Вернуть стандартную"
                      Command="{Binding RestoreRecommendedCommand}"
                      Padding="12,7" Background="#244875" BorderBrush="#416996"
                      CornerRadius="8" />
            </StackPanel>
            <TextBlock Text="Диагностика подбора стратегий" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StrategyDiagnostics}" FontSize="12" Foreground="#A2B3CB" TextWrapping="Wrap" />
            <TextBlock Text="Режим эксперта не меняет права доступа и системный прокси."
                       FontSize="11" Foreground="#8497B4"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
