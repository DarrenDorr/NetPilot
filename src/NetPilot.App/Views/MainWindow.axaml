<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetPilot.App.ViewModels"
        x:Class="NetPilot.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="920"
        Height="720"
        MinWidth="760"
        MinHeight="600">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="32" MaxWidth="1040">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Subtitle}" FontSize="15" Opacity="0.62" />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="Расширенный режим" FontSize="12" Opacity="0.62" HorizontalAlignment="Right" />
          <ToggleSwitch IsChecked="{Binding IsAdvancedMode}" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1"
              Margin="0,28,0,0"
              Padding="24"
              CornerRadius="18"
              BorderThickness="1"
              BorderBrush="#33808080">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="7">
            <TextBlock Text="Общее состояние" FontSize="14" Opacity="0.62" />
            <TextBlock Text="{Binding OverallStatus}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding OverallDetails}" FontSize="14" Opacity="0.70" TextWrapping="Wrap" MaxWidth="620" />
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0" Spacing="10">
            <Button Content="Установить сетевой движок"
                    Command="{Binding InstallEngineCommand}"
                    IsVisible="{Binding CanInstallEngine}"
                    Padding="18,10"
                    HorizontalAlignment="Stretch" />
            <Button Content="Проверить сейчас"
                    Command="{Binding CheckCommand}"
                    Padding="18,10"
                    HorizontalAlignment="Stretch" />
            <Button Content="Подобрать профиль"
                    Command="{Binding FindProfileCommand}"
                    Padding="18,10"
                    HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Grid.Row="2" Margin="0,22,0,0" Spacing="12">
        <TextBlock Text="Сервисы" FontSize="18" FontWeight="SemiBold" />

        <ItemsControl ItemsSource="{Binding Resources}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ResourceStatusViewModel">
              <Border Padding="18"
                      Margin="0,0,0,10"
                      CornerRadius="14"
                      BorderThickness="1"
                      BorderBrush="#28808080">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="{Binding StatusGlyph}"
                             Foreground="{Binding StatusBrush}"
                             FontSize="21"
                             VerticalAlignment="Center"
                             Margin="0,0,14,0" />

                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DetailsText}" FontSize="12" Opacity="0.58" TextWrapping="Wrap" />
                  </StackPanel>

                  <TextBlock Grid.Column="2"
                             Text="{Binding StatusText}"
                             Foreground="{Binding StatusBrush}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Margin="18,0,0,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Border Grid.Row="3"
              IsVisible="{Binding IsAdvancedMode}"
              Margin="0,12,0,0"
              Padding="20"
              CornerRadius="14"
              BorderThickness="1"
              BorderBrush="#33808080">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="Профили NetPilot" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Read-only каталог пользовательских профилей. Запуск недоступен, пока сетевой движок не прошёл security admission."
                       FontSize="12"
                       Opacity="0.58"
                       TextWrapping="Wrap" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding EngineProfiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EngineProfileViewModel">
                <Border Padding="12,9"
                        Margin="0,0,0,6"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="#20808080">
                  <Grid ColumnDefinitions="*,150,220">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Id}"
                               Opacity="0.55"
                               Margin="12,0,0,0" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusText}"
                               HorizontalAlignment="Right"
                               Margin="12,0,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Row="4"
              IsVisible="{Binding IsAdvancedMode}"
              Margin="0,12,0,0"
              Padding="20"
              CornerRadius="14"
              BorderThickness="1"
              BorderBrush="#33808080">
        <StackPanel Spacing="9">
          <TextBlock Text="Техническая информация" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Локальные сведения для поддержки. NetPilot не отправляет их автоматически."
                     FontSize="12"
                     Opacity="0.58"
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Text="Версия" Opacity="0.60" />
            <TextBlock x:Name="SupportVersionText" Grid.Column="1" Text="неизвестно" TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" Text="Платформа" Opacity="0.60" Margin="0,7,0,0" />
            <TextBlock x:Name="SupportPlatformText" Grid.Row="1" Grid.Column="1" Text="неизвестно" TextWrapping="Wrap" Margin="0,7,0,0" />

            <TextBlock Grid.Row="2" Text="Архитектура" Opacity="0.60" Margin="0,7,0,0" />
            <TextBlock x:Name="SupportArchitectureText" Grid.Row="2" Grid.Column="1" Text="неизвестно" TextWrapping="Wrap" Margin="0,7,0,0" />

            <TextBlock Grid.Row="3" Text="Движок" Opacity="0.60" Margin="0,7,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EngineStatus}" TextWrapping="Wrap" Margin="0,7,0,0" />

            <TextBlock Grid.Row="4" Text="Последнее действие" Opacity="0.60" Margin="0,7,0,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastAction}" TextWrapping="Wrap" Margin="0,7,0,0" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Grid.Row="5"
              IsVisible="{Binding IsAdvancedMode}"
              Margin="0,12,0,0"
              Padding="20"
              CornerRadius="14"
              BorderThickness="1"
              BorderBrush="#33808080">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="История диагностики" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DiagnosticHistorySummary}"
                         FontSize="12"
                         Opacity="0.66" />
              <TextBlock Text="Только в памяти · показываются последние 12 записей · URL, IP и содержимое трафика не сохраняются"
                         FontSize="12"
                         Opacity="0.58"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Очистить историю"
                    Command="{Binding ClearDiagnosticHistoryCommand}"
                    Margin="16,0,0,0"
                    Padding="14,8"
                    VerticalAlignment="Top" />
          </Grid>

          <ItemsControl ItemsSource="{Binding DiagnosticHistory}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DiagnosticHistoryItemViewModel">
                <Border Padding="10,8"
                        Margin="0,0,0,6"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="#20808080">
                  <Grid ColumnDefinitions="70,140,120,*">
                    <TextBlock Text="{Binding TimeText}" Opacity="0.62" />
                    <TextBlock Grid.Column="1" Text="{Binding ResourceName}" FontWeight="SemiBold" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding StateText}" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="3" Text="{Binding DetailsText}" Margin="8,0,0,0" Opacity="0.70" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
