<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetPilot.App.ViewModels"
        x:Class="NetPilot.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="920"
        Height="760"
        MinWidth="760"
        MinHeight="620">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="32" MaxWidth="1040">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Subtitle}" FontSize="15" Opacity="0.62" />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="Расширенный режим" FontSize="12" Opacity="0.62" HorizontalAlignment="Right" />
          <ToggleSwitch IsChecked="{Binding IsAdvancedMode}" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1"
              Margin="0,28,0,0"
              Padding="24"
              CornerRadius="18"
              BorderThickness="1"
              BorderBrush="#33808080">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="7">
            <TextBlock Text="Общее состояние" FontSize="14" Opacity="0.62" />
            <TextBlock Text="{Binding OverallStatus}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding OverallDetails}" FontSize="14" Opacity="0.70" TextWrapping="Wrap" MaxWidth="620" />
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0" Spacing="10">
            <Button Content="Проверить сейчас"
                    Command="{Binding CheckCommand}"
                    Padding="18,10"
                    HorizontalAlignment="Stretch" />
            <Button Content="Подобрать стратегию"
                    Command="{Binding FindStrategyCommand}"
                    Padding="18,10"
                    HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="2"
              Margin="0,16,0,0"
              Padding="20"
              CornerRadius="14"
              BorderThickness="1"
              BorderBrush="#33808080">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="5">
            <TextBlock Text="Сетевой движок" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding EngineInstallationStatus}" FontSize="14" TextWrapping="Wrap" />
            <TextBlock Text="Источник фиксирован: официальный Flowseal. URL и файлы нельзя подменить через интерфейс."
                       FontSize="12"
                       Opacity="0.58"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Button Grid.Column="1"
                  Content="{Binding EngineActionText}"
                  Command="{Binding ProvisionEngineCommand}"
                  Padding="18,10"
                  Margin="24,0,0,0"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="3" Margin="0,22,0,0" Spacing="12">
        <TextBlock Text="Сервисы" FontSize="18" FontWeight="SemiBold" />

        <ItemsControl ItemsSource="{Binding Resources}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ResourceStatusViewModel">
              <Border Padding="18"
                      Margin="0,0,0,10"
                      CornerRadius="14"
                      BorderThickness="1"
                      BorderBrush="#28808080">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="{Binding StatusGlyph}"
                             Foreground="{Binding StatusBrush}"
                             FontSize="21"
                             VerticalAlignment="Center"
                             Margin="0,0,14,0" />

                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DetailsText}" FontSize="12" Opacity="0.58" TextWrapping="Wrap" />
                  </StackPanel>

                  <TextBlock Grid.Column="2"
                             Text="{Binding StatusText}"
                             Foreground="{Binding StatusBrush}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Margin="18,0,0,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Border Grid.Row="4"
              IsVisible="{Binding IsAdvancedMode}"
              Margin="0,12,0,0"
              Padding="20"
              CornerRadius="14"
              BorderThickness="1"
              BorderBrush="#33808080">
        <StackPanel Spacing="9">
          <TextBlock Text="Техническая информация" FontSize="16" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
            <TextBlock Text="Движок" Opacity="0.60" />
            <TextBlock Grid.Column="1" Text="{Binding EngineStatus}" TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" Text="Последнее действие" Opacity="0.60" Margin="0,7,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastAction}" TextWrapping="Wrap" Margin="0,7,0,0" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
